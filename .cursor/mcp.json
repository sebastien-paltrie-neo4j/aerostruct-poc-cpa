{
    "mcpServers": {
      "neo4j-bmw": {
        "command": "neo4j-mcp",
        "env": {
          "NEO4J_URI": "neo4j+s://YOUR_URI",
          "NEO4J_USERNAME": "neo4j",
          "NEO4J_PASSWORD": "YOUR_PASSWORD",
          "NEO4J_DATABASE": "neo4j",
          "NEO4J_READ_ONLY": "true"
        }
      }
    }
}