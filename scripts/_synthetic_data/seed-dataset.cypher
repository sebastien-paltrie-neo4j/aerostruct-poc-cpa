// =============================================
// CPA Workshop — Seed Dataset
// AeroStruct S.A. — Critical Path Analysis
// =============================================
// Ontology: Aircraft, WorkOrder, Operation
// Relationships: FOR, PART_OF, PRECEDES
// =============================================

// --- Constraints ---
CREATE CONSTRAINT aircraft_tail IF NOT EXISTS FOR (a:Aircraft) REQUIRE a.tailNumber IS UNIQUE;
CREATE CONSTRAINT wo_number IF NOT EXISTS FOR (w:WorkOrder) REQUIRE w.woNumber IS UNIQUE;
CREATE CONSTRAINT op_id IF NOT EXISTS FOR (o:Operation) REQUIRE o.opId IS UNIQUE;

// --- Aircraft ---
MERGE (a:Aircraft {tailNumber: "AF-001"}) SET a.program = "Narrow-Body", a.deliveryDate = date("2026-05-15");
MERGE (a:Aircraft {tailNumber: "AF-002"}) SET a.program = "Wide-Body", a.deliveryDate = date("2026-06-15");
MERGE (a:Aircraft {tailNumber: "AF-003"}) SET a.program = "Regional", a.deliveryDate = date("2026-07-15");

// --- Work Orders, Operations, and intra-WO PRECEDES ---

// Work Order: WO-AF-001-01 (Started) for AF-001
MERGE (wo:WorkOrder {woNumber: "WO-AF-001-01"}) SET wo.status = "Started";
MATCH (a:Aircraft {tailNumber: "AF-001"}), (wo:WorkOrder {woNumber: "WO-AF-001-01"}) MERGE (wo)-[:FOR]->(a);
MERGE (op:Operation {opId: "OP-0001"}) SET op.name = "Panel Drilling", op.sequenceNumber = 10, op.estimatedDuration = 4, op.status = "Completed";
MATCH (wo:WorkOrder {woNumber: "WO-AF-001-01"}), (op:Operation {opId: "OP-0001"}) MERGE (op)-[:PART_OF]->(wo);
